# Claude categorization (server only). Either set a key here or rely on an `ant auth login` profile.
ANTHROPIC_API_KEY=
TOPIC_MODEL=claude-sonnet-5-5
# auto (API key -> anthropic, else claude -p with your Claude Code login, else offline) | anthropic | claude-cli | offline
TOPIC_PROVIDER=auto

# Local speech-to-text
STT_ENGINE=whispercpp            # whispercpp | whisperkit
WHISPER_MODEL_PATH=~/.cache/snakk/models/ggml-large-v3-turbo-q5_0.bin
WHISPER_SERVER_BIN=whisper-server
WHISPER_SERVER_PORT=8178
WHISPER_THREADS=8
# Languages we accept from auto-detection (ISO-639-1). Anything else is re-run with the last good language.
STT_LANGUAGES=no,en
# WhisperKit server (when STT_ENGINE=whisperkit)
WHISPERKIT_URL=http://127.0.0.1:50060

API_PORT=8787
