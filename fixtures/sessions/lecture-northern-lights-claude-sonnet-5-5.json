    {
      "type": "final",
      "segment": {
        "id": "lec6",
        "text": "When one of those is aimed at Earth, it takes about two to three days to arrive, and that is when we get the really strong displays.",
        "lang": "en",
        "startMs": 50434,
        "endMs": 59144,
        "latencyMs": 0
