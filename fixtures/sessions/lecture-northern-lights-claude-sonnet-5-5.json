      "type": "final",
      "segment": {
        "id": "lec3",
        "text": "So let us start with the sun. The sun is not a calm ball of fire, it is constantly throwing out charged particles.",
        "lang": "en",
        "startMs": 25072,
        "endMs": 32491,
        "latencyMs": 0
      },
