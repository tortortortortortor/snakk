    {
      "type": "final",
      "segment": {
        "id": "lec8",
        "text": "Now, the second piece of the puzzle is our own planet. Earth has a magnetic field, generated by the liquid iron in the outer core.",
        "lang": "en",
        "startMs": 69023,
        "endMs": 77088,
        "latencyMs": 0
