    {
      "type": "final",
      "segment": {
        "id": "lec5",
        "text": "Sometimes the sun has a much bigger outburst, a coronal mass ejection, which is like a billion tonnes of plasma flung into space.",
        "lang": "en",
        "startMs": 42015,
        "endMs": 49434,
        "latencyMs": 0
      },
      "forced": true,
      "t": 49934
    },
